create view codigoytotal as 
select pedido.codigo_pedido, pago.total 
from pago, pedido, cliente 
where (pago.codigo_cliente=cliente.codigo_cliente) and (pedido.codigo_cliente=cliente.codigo_cliente);


create view datosempleado as 
select concat(e.nombre, ", ", e.apellido1," ", e.apellido2) as empleado, concat(j.nombre, ", ", j.apellido1," ", j.apellido2) as jefe 
from empleado e left join empleado j on e.codigo_jefe=j.codigo_empleado join oficina o on e.codigo_oficina=o.codigo_oficina;


create view info_pedidos as 
select pedido.codigo_pedido, pedido.fecha_pedido, pedido.fecha_esperada, pedido.fecha_entrega, cliente.nombre_cliente, pago.total 
from pedido, cliente, pago 
where(pedido.codigo_cliente=cliente.codigo_cliente) and (pago.codigo_cliente=cliente.codigo_cliente) order by pago.total desc



create view masvendidos as 
select producto.gama, detalle_pedido.cantidad 
from producto, detalle_producto 
where (producto.codigo_producto=detalle_pedido.codigo_producto)
order by detalle_pedido.cantidad desc



create view menosvendidos as 
select pedido.codigo_pedido, cliente.pais 
from producto, detalle_pedido, cliente, pedido 
where (pedido.codigo_pedido=detalle_pedido.codigo_pedido) and (pedido.codigo_cliente=cliente.codigo_cliente) 
group by cliente.pais asc;
