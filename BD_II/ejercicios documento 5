create view codigoytotal as 
select pedido.codigo_pedido, pago.total 
from pago, pedido, cliente 
where (pago.codigo_cliente=cliente.codigo_cliente) and (pedido.codigo_cliente=cliente.codigo_cliente);


create view datosempleado as 
select concat(e.nombre, ", ", e.apellido1," ", e.apellido2) as empleado, concat(j.nombre, ", ", j.apellido1," ", j.apellido2) as jefe 
from empleado e left join empleado j on e.codigo_jefe=j.codigo_empleado
;


